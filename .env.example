# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real keys.
# The deploy workflow reads the same names from repository secrets
# (Settings > Secrets and variables > Actions).
#
# Flutter reads them at build time. For local runs, put the two public
# values in env.json (also git-ignored), e.g.
#   { "SUPABASE_URL": "https://yourproject.supabase.co",
#     "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_..." }
# and run:  flutter run -d chrome --dart-define-from-file=env.json

# --- Safe to ship in the app, and therefore safe to deploy -------------------
# These identify your project. Supabase documents them as safe to expose in a
# client. The RLS and Storage policies in supabase/migrations/ are what
# protect the data, not the secrecy of these values.
# (Dashboard > Project Settings > API Keys: use the PUBLISHABLE / anon key.)
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_PUBLISHABLE_KEY=put_your_publishable_key_here

# Background removal runs on-device in the browser (web/bg_removal/), so it
# needs no endpoint and no key.

# --- NEVER ship or deploy ----------------------------------------------------
# Billable or privileged credentials. Keep these local. A stranger can read
# anything you compile into a web build and spend your quota with it.
# The app does not need any of these. The app refuses to start if the
# publishable-key slot is given a secret key by mistake.
# SUPABASE_SECRET_KEY=never_put_this_in_a_client_app
